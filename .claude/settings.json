{
  "effortLevel": "high",
  "enableAllProjectMcpServers": true,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-cs-check.js",
            "timeout": 30,
            "statusMessage": "Checking C# scripts before commit..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-commit-doc-check.js",
            "timeout": 10,
            "statusMessage": "Checking doc sync..."
          }
        ]
      }
    ]
  }
}
